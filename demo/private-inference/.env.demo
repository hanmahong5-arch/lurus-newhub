# Local one-click demo env — private-inference-routing demo ONLY.
# Deliberately separate from .env / .env.dev so this never clobbers whatever
# another concurrent session is pointed at.
SQL_DSN=postgres://postgres:postgres@localhost:5435/newhub
REDIS_CONN_STRING=
SESSION_SECRET=demo-private-inference-not-for-prod
GIN_MODE=debug
PORT=8099
SESSION_COOKIE_DOMAIN=
MEILISEARCH_ENABLED=false
OTEL_TRACING_ENABLED=false
IDENTITY_SERVICE_URL=
# Gates the Playwright-style bridge login route (POST /api/v2/bridge/exchange)
# so shot-console.mjs can authenticate without a manually-exported cookie.
# Registered ONLY when this is non-empty (see internal/adapter/handler/v2_bridge.go).
E2E_BRIDGE_TOKEN=demo-bridge-privinf-local-only
