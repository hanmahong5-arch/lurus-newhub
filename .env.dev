# Local dev — matches docker-compose.dev.yml
SQL_DSN=postgresql://root:123456@localhost:5434/newhub
REDIS_CONN_STRING=redis://localhost:6380
SESSION_SECRET=dev-secret-do-not-use-in-prod
GIN_MODE=debug
PORT=3000

# Optional — disable features that need external services in local dev
MEILISEARCH_ENABLED=false
OTEL_TRACING_ENABLED=false

# Identity platform (HTTP)
IDENTITY_SERVICE_URL=
