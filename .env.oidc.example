# OIDC Configuration for lurus-api Multi-Tenant SaaS (vendor-neutral)
# OIDC 配置 - lurus-api 多租户 SaaS（厂商中性，任意标准 OIDC 提供方）
#
# All values below are deploy-time, provider-specific and owner-gated.
# 所有值均为部署期注入、与具体提供方相关、需 owner 决定。
# Prefer resolving endpoints from <issuer>/.well-known/openid-configuration.
# 推荐从 <issuer>/.well-known/openid-configuration 解析端点。

# ================================
# OIDC Instance / OIDC 实例
# ================================

# OIDC Issuer URL (the iss claim value). Comma-separated values are accepted to
# run two issuers concurrently during an IdP migration window.
# OIDC 签发者 URL（iss claim 值）。逗号分隔可在 IdP 迁移窗口内同时接受两个 issuer。
OIDC_ISSUER=

# ================================
# OAuth 2.0 Client Credentials / OAuth 2.0 客户端凭据
# ================================

# OIDC Client ID (also used as the expected audience)
# OIDC 客户端 ID（同时用作期望的 audience）
OIDC_CLIENT_ID=YOUR_CLIENT_ID_HERE

# OIDC Client Secret (generate from your OIDC provider console)
# OIDC 客户端密钥（从你的 OIDC 提供方控制台生成）
# WARNING: Keep this secret! Do not commit to git!
# 警告：保密！不要提交到 git！
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ================================
# Redirect URIs / 重定向 URI
# ================================

# OAuth Callback URL (where the IdP redirects after login)
# OAuth 回调 URL（IdP 登录后重定向地址）
OIDC_REDIRECT_URI=https://api.lurus.cn/api/v2/oauth/callback

# Post Logout Redirect URI (where to redirect after logout)
# 登出后重定向 URI
OIDC_POST_LOGOUT_REDIRECT_URI=https://api.lurus.cn/logout

# ================================
# OIDC Endpoints / OIDC 端点
# (Best practice: resolve from the discovery document; override only if needed.)
# (最佳实践：从 discovery 文档解析；仅在必要时覆盖。)
# ================================

# JWKS URI (for JWT public key verification) — ideally discovery jwks_uri
# JWKS URI（用于 JWT 公钥验证）—— 理想情况来自 discovery jwks_uri
OIDC_JWKS_URI=

# Optional endpoint path overrides (relative to issuer).
# 可选的端点路径覆盖（相对 issuer）。
#OIDC_AUTHORIZE_PATH=/oauth/v2/authorize
#OIDC_TOKEN_PATH=/oauth/v2/token
#OIDC_END_SESSION_PATH=/oidc/v1/end_session

# ================================
# Configurable Claim Keys / 可配置 claim key
# Defaults are vendor-neutral; set to whatever (possibly vendor-prefixed) claim
# keys your IdP advertises for org id / org domain / resource owner / roles.
# 默认厂商中性；按你的 IdP 实际声明的 claim key（可能带厂商前缀）设置。
# ================================
#OIDC_CLAIM_ORG_ID=org_id
#OIDC_CLAIM_ORG_DOMAIN=org_domain
#OIDC_CLAIM_RESOURCE_OWNER_ID=resource_owner_id
#OIDC_CLAIM_RESOURCE_OWNER_NAME=resource_owner_name
#OIDC_CLAIM_ROLES=roles

# ================================
# OAuth Scopes / OAuth 范围
# ================================

# OAuth 2.0 Scopes (space-separated)
# OAuth 2.0 范围（空格分隔）
OIDC_OAUTH_SCOPES=openid email profile offline_access

# ================================
# Multi-Tenant Settings / 多租户设置
# ================================

# Enable Auto Tenant Creation (create tenant when new org detected)
# 启用自动租户创建（检测到新组织时创建租户）
OIDC_AUTO_CREATE_TENANT=true

# Enable Auto User Mapping (create lurus user on first OIDC login)
# 启用自动用户映射（首次 OIDC 登录时创建 lurus 用户）
OIDC_AUTO_CREATE_USER=true

# ================================
# Security Settings / 安全设置
# ================================

# Enable PKCE (Proof Key for Code Exchange, recommended: true)
# 启用 PKCE（推荐：true）
OIDC_ENABLE_PKCE=true

# Comma-separated list of allowed redirect domains after OAuth.
# OAuth 后允许的重定向域名列表（逗号分隔）。
OIDC_ALLOWED_REDIRECT_DOMAINS=lurus.cn,api.lurus.cn

# ================================
# Debug & Logging / 调试与日志
# ================================

# Enable OIDC Auth Debug Logging
# 启用 OIDC 认证调试日志
OIDC_DEBUG_LOGGING=false

# ================================
# Integration Settings / 集成设置
# ================================

# Enable OIDC Integration (set to false to use legacy auth)
# 启用 OIDC 集成（设为 false 使用旧版认证）
OIDC_ENABLED=true

# ================================
# Notes / 备注
# ================================

# 1. Replace YOUR_CLIENT_ID_HERE with the actual Client ID from your IdP console
#    将 YOUR_CLIENT_ID_HERE 替换为 IdP 控制台的实际 Client ID
#
# 2. Replace YOUR_CLIENT_SECRET_HERE with the actual Client Secret from your IdP console
#    将 YOUR_CLIENT_SECRET_HERE 替换为 IdP 控制台的实际 Client Secret
#
# 3. DO NOT commit the real .env file to git! Add it to .gitignore
#    不要将真实 .env 文件提交到 git！将其添加到 .gitignore
#
# 4. For production, use environment variables or secrets management instead
#    生产环境建议使用环境变量或密钥管理系统
#
# 5. Test configuration with: curl <OIDC_ISSUER>/.well-known/openid-configuration
#    测试配置：curl <OIDC_ISSUER>/.well-known/openid-configuration
