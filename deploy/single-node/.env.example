# ─── Required: Database ─────────────────────────────────────────────────────
# Pick a strong password. The PG container creates user `lurus` with this on
# first boot; changing it later requires entering the container.
POSTGRES_PASSWORD=ReplaceWithStrongPassword
POSTGRES_DB=lurus_hub

# ─── Required: Session ─────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
SESSION_SECRET=ReplaceWithBase64Secret

# Cookie Domain attribute. Leave empty for host-only cookie (correct when
# accessed via IP or any single host). Set to ".your-domain.com" only if you
# need cross-subdomain SSO (e.g. ".lurus.cn"). Browsers silently drop the
# cookie when Domain doesn't match the request host, which surfaces as
# "Not logged in" right after a successful OIDC login.
SESSION_COOKIE_DOMAIN=

# ─── Required: OIDC (deploy-time, owner-gated; e.g. reuse identity.lurus.cn) ─
# Host below WAS auth.lurus.cn — a 301 alias scheduled for teardown on
# 2026-08-19 (still serving 301 as of 2026-08-22, but on borrowed time). An
# install pinned to the alias dies at discovery/JWKS the moment DNS drops, so
# the canonical issuer host is inlined here. Self-hosting against your own IdP: replace the host in all
# seven URLs below (they must ALL share one origin — a split between issuer
# and JWKS makes token validation fail with a confusing 401).
OIDC_ENABLED=true
OIDC_FALLBACK_TO_LEGACY=true

OIDC_ISSUER=https://identity.lurus.cn
OIDC_CLIENT_ID=YOUR_CLIENT_ID@lurus-hub
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET

# IMPORTANT: register this exact URL as a Redirect URI in your OIDC provider console
# for the client above. Replace 10.0.0.42:3000 with your server IP and port.
OIDC_REDIRECT_URI=http://10.0.0.42:3000/api/v2/oauth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://10.0.0.42:3000/logout

OIDC_JWKS_URI=https://identity.lurus.cn/oauth/v2/keys
OIDC_AUTHORIZATION_ENDPOINT=https://identity.lurus.cn/oauth/v2/authorize
OIDC_TOKEN_ENDPOINT=https://identity.lurus.cn/oauth/v2/token
OIDC_USERINFO_ENDPOINT=https://identity.lurus.cn/oidc/v1/userinfo
OIDC_END_SESSION_ENDPOINT=https://identity.lurus.cn/oidc/v1/end_session
OIDC_INTROSPECTION_ENDPOINT=https://identity.lurus.cn/oauth/v2/introspect

OIDC_DEFAULT_ORG_ID=YOUR_ORG_ID
OIDC_DEFAULT_ORG_NAME=Lurus Platform
OIDC_DEFAULT_ORG_DOMAIN=lurus
OIDC_OAUTH_SCOPES=openid email profile offline_access

# ─── Optional ──────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
PUBLIC_PORT=3000

# ─── Optional: PG backups (wal-g → S3-compatible store) ────────────────────
# Continuous WAL archiving + scheduled base backups. When WALG_S3_PREFIX is
# empty, archive_command no-ops and PG runs without backups — acceptable for
# first boot; flip on once you've provisioned the bucket.
#
# After setting these and `docker compose up -d`, take the FIRST base backup:
#   docker exec lurus-postgres wal-g backup-push /var/lib/postgresql/data
# Then add a host-side cron line for daily backups:
#   0 3 * * * docker exec lurus-postgres wal-g backup-push /var/lib/postgresql/data >> /var/log/lurus-pg-backup.log 2>&1
#
# Restore steps + drill: see doc/runbook/pg-restore.md.
# e.g. s3://lurus-pg-backups
WALG_S3_PREFIX=
# e.g. http://minio:9000   or   https://oss-cn-hangzhou.aliyuncs.com
WALG_AWS_ENDPOINT=
WALG_AWS_ACCESS_KEY_ID=
WALG_AWS_SECRET_ACCESS_KEY=
# Aliyun OSS users override with oss-cn-hangzhou etc.
WALG_AWS_REGION=us-east-1
# lz4 (fast, default) | zstd (denser) | brotli
WALG_COMPRESSION_METHOD=lz4
