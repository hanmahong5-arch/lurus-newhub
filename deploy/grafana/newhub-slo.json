{
  "annotations": { "list": [] },
  "description": "Lurus Hub Phase 1 hardening SLO dashboard. Tracks the four north-star SLIs: availability, p95 latency, gateway overhead (target <50ms), and circuit breaker state. Import via Grafana → Dashboards → Import.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Availability — 5m success rate",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "(1 - sum(rate(lurus_gateway_requests_total{status=~\"5..\"}[5m])) / sum(rate(lurus_gateway_requests_total[5m]))) * 100",
          "legendFormat": "availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null  },
              { "color": "orange", "value": 99    },
              { "color": "green",  "value": 99.5  }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "title": "p95 total latency",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lurus_gateway_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 1000 },
              { "color": "red",    "value": 3000 }
            ]
          }
        }
      }
    },
    {
      "title": "Gateway overhead (p95 total - p95 upstream) — target <50ms",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "description": "North-star SLI: how much latency newhub adds on top of the upstream provider. Includes channel-select, auth, billing, NATS publish.",
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum(rate(lurus_gateway_request_duration_seconds_bucket[5m])) by (le)) - histogram_quantile(0.95, sum(rate(lurus_gateway_relay_duration_seconds_bucket[5m])) by (le))) * 1000",
          "legendFormat": "overhead ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 50   },
              { "color": "red",    "value": 100  }
            ]
          }
        }
      }
    },
    {
      "title": "Active connections",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "lurus_gateway_active_connections", "legendFormat": "in-flight" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "title": "Request rate by status (5m rate)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(lurus_gateway_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "title": "Latency p50 / p95 / p99 (total request)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(lurus_gateway_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(lurus_gateway_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(lurus_gateway_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },

    {
      "title": "Story 7-1 — Circuit breaker state per channel",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "description": "0=closed (healthy), 1=open (rejecting), 2=half-open (probing). Spikes to 1 are normal during chaos; should return to 0 within cool-down.",
      "targets": [
        {
          "expr": "lurus_gateway_circuit_breaker_state",
          "legendFormat": "channel={{channel_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "max": 2,
          "min": 0
        }
      }
    },
    {
      "title": "Story 7-1 — Circuit breaker trips & rejections (5m rate)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(lurus_gateway_circuit_breaker_trips_total[5m]))", "legendFormat": "trips/s" },
        { "expr": "sum(rate(lurus_gateway_circuit_breaker_rejections_total[5m]))", "legendFormat": "rejections/s" }
      ]
    },

    {
      "title": "Story 7-4 — 402 quota-denied (Retry-After clients)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "description": "Spike here = users hitting MaxQuota cap. Confirm clients respect Retry-After (no thundering herd as month resets).",
      "targets": [
        {
          "expr": "sum(rate(lurus_gateway_requests_total{status=\"402\"}[5m]))",
          "legendFormat": "402/s"
        }
      ]
    },
    {
      "title": "Story 8-2.1 — Cost spike auto-disables (429 rate)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "description": "Sudden 429 spike on a single user = agent loop or runaway script caught by the 5-min sliding window guard. Investigate.",
      "targets": [
        {
          "expr": "sum(rate(lurus_gateway_requests_total{status=\"429\"}[5m]))",
          "legendFormat": "429/s"
        }
      ]
    },

    {
      "title": "Quota consumption rate (per tenant, top 10)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "topk(10, sum(rate(lurus_gateway_quota_consumed_total[5m])) by (tenant_id))",
          "legendFormat": "tenant={{tenant_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Tokens processed (input vs output, 5m rate)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(lurus_gateway_tokens_processed_total[5m])) by (token_type)",
          "legendFormat": "{{token_type}}"
        }
      ]
    },

    {
      "title": "Billing — pre-auth latency (Phase 5 settlement health)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(lurus_billing_preauth_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95 preauth ms"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Billing — outbox depth + circuit breaker",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "description": "outbox_pending growing = platform settlement is failing. circuit_breaker_state=1 = newhub stopped trying.",
      "targets": [
        { "expr": "lurus_billing_outbox_pending",      "legendFormat": "outbox depth" },
        { "expr": "lurus_billing_circuit_breaker_state", "legendFormat": "platform breaker" }
      ]
    },

    {
      "title": "Credit pool balance per tenant (ADR 2026-05-18)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "description": "Reseller-facing remaining balance per tenant. <1000 triggers CreditPoolBalanceLow alert; <=0 triggers CreditPoolExhausted (page).",
      "targets": [
        { "expr": "lurus_gateway_credit_pool_balance", "legendFormat": "{{tenant_id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Credit pool debit rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "description": "Per-tenant debit rate from PostConsumeQuota Phase 2.5. Spikes here = LLM traffic acceleration; sustained zero = tenant idle.",
      "targets": [
        { "expr": "sum(rate(lurus_gateway_credit_pool_debit_total[5m])) by (tenant_id)", "legendFormat": "{{tenant_id}}" }
      ]
    },
    {
      "title": "Provisioning keys created (1h rate)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 52, "w": 24, "h": 8 },
      "description": "Switch-Reseller adoption signal. Each spike = a Reseller issuing keys to new end-customers via the Provisioning API.",
      "targets": [
        { "expr": "sum(rate(lurus_gateway_provisioning_keys_created_total[1h])) by (tenant_id)", "legendFormat": "{{tenant_id}}" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "tags": ["lurus-hub", "slo", "phase-1"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "title": "Lurus Hub — Phase 1 SLO",
  "uid": "lurus-hub-phase1-slo",
  "version": 1
}
